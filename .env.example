NODE_ENV=development
WHATSAPP_SESSION_DIR=auth/whatsapp
WHATSAPP_ALLOWED_CHAT_NAME=docs_bot
QR_CODE_WEB_PORT=3334
FORM_SUBMISSION_HTTP_PORT=3335
DOCUMENT_PROCESSING_CONCURRENCY=1

# Autenticação da API (docs/prd-autenticacao-bot-wpp.md, no effectus-api)
# Segredo HS256 do projeto Supabase. Sem ele, cada sessão nova é validada por
# chamada ao Supabase.
SUPABASE_JWT_SECRET=
# Fase 1: a chave antiga (FORM_SUBMISSION_API_KEY) ainda vale. false na fase 3.
ACCEPT_LEGACY_API_KEY=true
# Fase 2: log = só registra identidade divergente do token; enforce = usa a do token.
IDENTITY_MODE=log
# Origens do app, separadas por vírgula. Vazio mantém "*".
CORS_ALLOWED_ORIGINS=
# Painel do QR (sem autenticação). 127.0.0.1 fora do desenvolvimento local.
QR_CODE_WEB_HOST=127.0.0.1
STORAGE_PROVIDER=supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=docs-bot
SUPABASE_FOLDER=whatsapp
LOCAL_DOCUMENTS_MIRROR_ENABLED=false
LOCAL_DOCUMENTS_ROOT=/app/docs
OCR_PROVIDER=disabled
OCR_LANGUAGE=por
TEMP_DIR=tmp/uploads

# Fluxo OneDrive pausado temporariamente.
# ONEDRIVE_PROVIDER=mock
# ONEDRIVE_TENANT_ID=
# ONEDRIVE_CLIENT_ID=
# ONEDRIVE_CLIENT_SECRET=
# ONEDRIVE_REFRESH_TOKEN=
# ONEDRIVE_REDIRECT_URI=http://localhost:3333/auth/onedrive/callback
# ONEDRIVE_FOLDER=/docs

# Captação de leads via anúncios do Instagram (Meta Lead Ads)
# disabled = rotas desligadas | fake = simula a Meta (dev) | graph = Meta de verdade
META_ADS_PROVIDER=disabled
# META_APP_ID=
# META_APP_SECRET=
# META_API_VERSION=v23.0
# META_LOGIN_CONFIG_ID=
# Precisa bater com o "URI de redirecionamento OAuth válido" cadastrado no app da Meta
# META_OAUTH_REDIRECT_URI=https://api.effectuscb.com/api/lead-ads/meta/callback
# Texto livre que você inventa e cola também no painel de Webhooks da Meta
# META_WEBHOOK_VERIFY_TOKEN=
# Gere com: openssl rand -base64 32 (não troque depois: tokens salvos ficam ilegíveis)
# META_TOKEN_ENCRYPTION_KEY=
# META_PRIVACY_POLICY_URL=https://effectuscb.com/privacidade
# META_SPECIAL_AD_CATEGORIES=HOUSING
